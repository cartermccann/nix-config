+NODE_METHOD(Database::JS_updateHook) {
+	Database* db = Unwrap<Database>(info.This());
+	REQUIRE_DATABASE_OPEN(db);
+	REQUIRE_DATABASE_NOT_BUSY(db);
+	REQUIRE_DATABASE_NO_ITERATORS(db);
+
+	if (info.Length() == 0) {
+		sqlite3_update_hook(db->db_handle, NULL, NULL);
+		db->update_hook.Reset();
+		return;
+	}
+
+	REQUIRE_ARGUMENT_FUNCTION(first, v8::Local<v8::Function> fn);
+	UseIsolate;
+	db->update_hook.Reset(isolate, fn);
+	sqlite3_update_hook(db->db_handle, Database::UpdateHookCallback, db);
+}
+
+void Database::UpdateHookCallback(void* self, int op, const char* db_name, const char* table, sqlite3_int64 rowid) {
+	Database* db = static_cast<Database*>(self);
+	if (db->update_hook.IsEmpty() || db->was_js_error) return;
+
+	EasyIsolate;
+	v8::HandleScope scope(isolate);
+
+	const char* op_str;
+	switch (op) {
+		case SQLITE_INSERT: op_str = "insert"; break;
+		case SQLITE_UPDATE: op_str = "update"; break;
+		case SQLITE_DELETE: op_str = "delete"; break;
+		default: return;
+	}
+
+	v8::Local<v8::Value> args[4] = {
+		StringFromUtf8(isolate, op_str, -1),
+		StringFromUtf8(isolate, db_name ? db_name : "", -1),
+		StringFromUtf8(isolate, table ? table : "", -1),
+		db->safe_ints
+			? v8::BigInt::New(isolate, rowid).As<v8::Value>()
+			: v8::Number::New(isolate, (double)rowid).As<v8::Value>(),
+	};
+
+	if (db->update_hook.Get(isolate)
+			->Call(OnlyContext, v8::Undefined(isolate), 4, args)
+			.IsEmpty()) {
+		db->was_js_error = true;
+	}
+}
+
 NODE_METHOD(Database::JS_defaultSafeIntegers) {
 	Database* db = Unwrap<Database>(info.This());
 	if (info.Length() == 0) db->safe_ints = true;
