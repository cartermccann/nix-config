diff --git i/tests/test_generic_core.py w/tests/test_generic_core.py
index 8c5fe8a..9b613f8 100644
--- i/tests/test_generic_core.py
+++ w/tests/test_generic_core.py
@@ -204,6 +204,29 @@ class CoreTests(unittest.TestCase):
         self.assertEqual(self.flush()["halted"], 1)
         self.assertFalse(FakeSink.calls)
 
+    def test_reboot_changed_device_number_keeps_legacy_binding(self):
+        # btrfs subvolumes get a new anonymous st_dev on each boot; the
+        # checkout itself (path, origin, common dir, inode) is unchanged.
+        self.submit(self.event(), self.event(2, "message.completed"))
+        info = self.repo.stat()
+        db = sqlite3.connect(self.state / "ingress.sqlite3")
+        with db:
+            db.execute("UPDATE sessions SET fingerprint=?", (f"{info.st_dev + 11}:{info.st_ino}",))
+        db.close()
+        result = self.flush()
+        self.assertEqual(result["halted"], 0)
+        self.assertEqual(result["delivered_sessions"], 1)
+
+    def test_replaced_checkout_inode_still_halts(self):
+        self.submit(self.event(), self.event(2, "message.completed"))
+        info = self.repo.stat()
+        db = sqlite3.connect(self.state / "ingress.sqlite3")
+        with db:
+            db.execute("UPDATE sessions SET fingerprint=?", (f"{info.st_dev}:{info.st_ino + 1}",))
+        db.close()
+        self.assertEqual(self.flush()["halted"], 1)
+        self.assertFalse(FakeSink.calls)
+
     def test_fencing_isolated_per_session_and_retryable_retained(self):
         self.submit(self.event(), self.event(2, "message.completed"))
         FakeSink.failure = DeltaUnavailable("test")
