diff --git i/t3_delta/engine.py w/t3_delta/engine.py
index f613439..bad5e9c 100644
--- i/t3_delta/engine.py
+++ w/t3_delta/engine.py
@@ -13,6 +13,32 @@ def utc_now():
     return dt.datetime.now(dt.timezone.utc).isoformat()
 
 
+def directory_fingerprint(directory):
+    """Return a reboot-stable identity for a checkout directory.
+
+    ``st_dev`` is not stable across boots on btrfs subvolumes (and other
+    filesystems that use anonymous device numbers), so bind to the
+    filesystem id reported by ``statvfs`` plus the directory inode.
+    """
+    info = os.stat(directory)
+    return f"fs:{os.statvfs(directory).f_fsid:x}:{info.st_ino}"
+
+
+def fingerprint_matches(stored, directory):
+    """Compare a persisted binding with the live checkout directory.
+
+    Bindings written before ``directory_fingerprint`` used ``st_dev:st_ino``.
+    Those still match when the inode is unchanged, because the device number
+    alone can change on every boot without the checkout being replaced.
+    """
+    if not isinstance(stored, str):
+        return False
+    if stored == directory_fingerprint(directory):
+        return True
+    device, separator, inode = stored.partition(":")
+    return bool(separator) and device.isdigit() and inode.isdigit() and int(inode) == os.stat(directory).st_ino
+
+
 def timestamp(value):
     return dt.datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
 
